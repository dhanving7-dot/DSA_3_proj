# Copy this file to .env and adjust as needed.
# For local development without Docker, the default sqlite:///./dev.db works out of the box.

PROJECT_NAME="Student-Laboratory Allocation Engine"

# Postgres (used automatically when running via docker-compose)
DATABASE_URL=postgresql+psycopg2://allocatex:allocatex@postgres:5432/allocatex

REDIS_URL=redis://redis:6379/0

# Generate a real secret for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional: enables a real LLM to assist natural-language parsing quality in
# app/services/ai_service.py. The rule-based parser is the default and works
# fully offline without this key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

RATE_LIMIT_PER_MINUTE=120
ENV=development
